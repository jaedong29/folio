# EC2 스테이징용 예시. 실제 값은 이 파일을 복사한 .env에만 넣고 Git에 커밋하지 않는다.
SPRING_PROFILES_ACTIVE=mysql,prod
APP_PORT=8080
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
APP_PRICE_EXTERNAL_ENABLED=true
# Enable only after HTTPS, credential storage and provider service terms are checked.
APP_CONNECTIONS_ENABLED=false
# openssl rand -base64 32
APP_CONNECTIONS_ENCRYPTION_KEY=
APP_CONNECTIONS_SYNC_INTERVAL_SECONDS=300
# Financial Evidence Agent. Enable only with a real NVIDIA_API_KEY for the session; never commit the key.
APP_AI_ENABLED=false
NVIDIA_API_KEY=
APP_AI_BASE_URL=https://integrate.api.nvidia.com/v1
APP_AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# APP_NEWS_SUMMARY_ENABLED is left out on purpose: unset, it follows APP_AI_ENABLED.
# Add "APP_NEWS_SUMMARY_ENABLED=false" here only if you want to diverge from that.
APP_AI_DAILY_CALL_LIMIT=200
APP_AI_DAILY_TOKEN_LIMIT=200000
APP_RETENTION_AUDIT_LOG_DAYS=365
APP_RETENTION_AGENT_TRACE_DAYS=30
APP_RETENTION_EVALUATION_BATCH_DAYS=90
APP_RESILIENCE_YAHOO_MAX_ATTEMPTS=2
APP_RESILIENCE_BINANCE_MAX_ATTEMPTS=2
APP_RESILIENCE_UPBIT_MAX_ATTEMPTS=2
APP_RESILIENCE_GITHUB_MAX_ATTEMPTS=3

DB_HOST=mysql
DB_PORT=3306
DB_NAME=assetdashboard
DB_USERNAME=asset
DB_PASSWORD=replace-with-a-db-password

MYSQL_ROOT_PASSWORD=replace-with-a-root-password
MYSQL_DATABASE=assetdashboard
MYSQL_USER=asset
MYSQL_PASSWORD=replace-with-a-db-password
TZ=Asia/Seoul
